# Base de données (SQLite local)
DATABASE_URL="file:./dev.db"

# Port d'écoute de l'application (next start le lit automatiquement).
# En déploiement VPS, deploy/setup.sh choisit un port libre et met cette
# valeur à jour automatiquement pour éviter tout conflit avec une autre
# application déjà en écoute.
PORT="3000"

# Stripe (mode TEST) — https://dashboard.stripe.com/test/apikeys
# Sans ces clés, le tunnel de commande fonctionne en mode démo
# (la commande est enregistrée en base mais aucun paiement réel n'est déclenché).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# URL publique du site, utilisée pour les redirections Stripe
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Administration (/admin) — CHANGEZ ces deux valeurs avant toute mise en ligne.
# ADMIN_PASSWORD : mot de passe du compte admin unique.
# ADMIN_SESSION_SECRET : chaîne aléatoire longue utilisée pour signer la session.
#   Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD="changeme"
ADMIN_SESSION_SECRET=""
